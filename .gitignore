node_modules/
main.js
*.js.map
.gitkeep
.claude/
.hotreload

# Python bytecode cache from the vendored engine bundle (assets/engine/forge/),
# regenerated on import — never should have been trackable, was blocking
# release.sh's clean-working-tree check as untracked cruft. Added 2026-09-18.
__pycache__/
*.pyc

# Pyodide binary assets (assets/pyodide/) ARE committed for BRAT
# distribution — Tamar's closed-beta audience can't run terminal
# commands post-install. `npm run setup-assets` is still useful for
# re-populating after Pyodide version upgrades. ~14.6 MB in repo.
#
# The combined asset manifest regenerates on every `npm run build`
# (paths depend on which wheels are present); stays gitignored.
assets/manifest.json

# Release zips for V1 distribution; produced by `npm run release-zip`.
# Upload to GitHub Releases manually per V1 closed-beta workflow.
dist/

# npm run build outputs — regenerate on every build
src/bundled-assets.generated.ts
src/version-constant.generated.ts
src/asset-manifest.generated.ts

# Music edition: the 11 music21-chain wheels are FETCHED + sha256-verified into assets/wheels/ by
# `npm run fetch-music-wheels` (pins: scripts/music-wheels.json) — never committed, so the lean build
# and the repo stay free of 22.8 MB of binaries.
assets/wheels/

# Build identifier (short SHA + time), regenerated by scripts/inline-plugin-version.mjs on every build.
src/build-stamp.generated.ts
